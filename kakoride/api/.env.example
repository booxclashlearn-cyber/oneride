# Development defaults need no cloud account. Never load the old root .env.local.
KAKORIDE_ENVIRONMENT=development
KAKORIDE_STORAGE=sqlite
# KAKORIDE_LOCAL_DATABASE=C:/path/to/development.sqlite
KAKORIDE_WEB_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Production: use firestore, a Google project, ADC/service identity, and a private key.
# KAKORIDE_ENVIRONMENT=production
# KAKORIDE_STORAGE=firestore
KAKORIDE_GOOGLE_CLOUD_PROJECT=
KAKORIDE_FIRESTORE_NAMESPACE=kakoride
KAKORIDE_CONTACT_HMAC_KEY=

# Meta WhatsApp Cloud API (secrets server-side only).
KAKORIDE_WHATSAPP_APP_SECRET=
KAKORIDE_WHATSAPP_VERIFY_TOKEN=
KAKORIDE_WHATSAPP_ACCESS_TOKEN=
KAKORIDE_WHATSAPP_PHONE_NUMBER_ID=
KAKORIDE_WHATSAPP_GRAPH_VERSION=v27.0

# Telerivet incoming-message Webhook service + REST sender.
KAKORIDE_TELERIVET_WEBHOOK_SECRET=
KAKORIDE_TELERIVET_API_KEY=
KAKORIDE_TELERIVET_PROJECT_ID=

# Full Cloud Run origin as OIDC audience; Scheduler every minute POSTs /internal/jobs/sweep.
KAKORIDE_INTERNAL_JOB_AUDIENCE=
KAKORIDE_JOB_SERVICE_ACCOUNT_EMAIL=
# Optional Cloud Tasks queue: projects/PROJECT/locations/REGION/queues/reminders
KAKORIDE_CLOUD_TASKS_QUEUE=
